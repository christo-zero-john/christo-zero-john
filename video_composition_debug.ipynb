# DEBUGGING CELL - Run this if you encounter errors
print("=== VIDEO COMPOSITION DEBUGGING ===")

# Check if files exist
import os
template_path = "/kaggle/input/green-screen-assets/mockup-2.mp4"
product_path = "/kaggle/input/green-screen-assets/keraverse.mp4"

print("🔍 Checking file paths...")
print(f"Template video exists: {os.path.exists(template_path)} - {template_path}")
print(f"Product video exists: {os.path.exists(product_path)} - {product_path}")

# List available files
print("\n📁 Available files in input directory:")
try:
    input_base = "/kaggle/input"
    if os.path.exists(input_base):
        for root, dirs, files in os.walk(input_base):
            for file in files:
                if file.endswith(('.mp4', '.avi', '.mov', '.mkv')):
                    print(f"  📹 {os.path.join(root, file)}")
    else:
        print("  ❌ Input directory not found")
except Exception as e:
    print(f"  ❌ Error listing files: {e}")

# Check OpenCV installation
print("\n🔧 Checking OpenCV...")
try:
    import cv2
    print(f"  ✅ OpenCV version: {cv2.__version__}")
    
    # Test video capture
    if os.path.exists(template_path):
        cap = cv2.VideoCapture(template_path)
        if cap.isOpened():
            print(f"  ✅ Can open template video")
            cap.release()
        else:
            print(f"  ❌ Cannot open template video")
    else:
        print(f"  ⚠️ Template video file not found")
        
except ImportError as e:
    print(f"  ❌ OpenCV import error: {e}")
except Exception as e:
    print(f"  ❌ OpenCV test error: {e}")

# Check other dependencies
print("\n📦 Checking dependencies...")
required_packages = ['numpy', 'tqdm', 'scipy', 'skimage']
for package in required_packages:
    try:
        __import__(package)
        print(f"  ✅ {package} - OK")
    except ImportError:
        print(f"  ❌ {package} - Missing")

print("\n💡 If you see any ❌ above, that's likely the source of your error!")
print("Copy the exact error message and I'll help you fix it.")