def compose_video(template_path=None, product_path=None, output_dir=None, 
                 detection_method=None, max_frames=None, enable_logging=True):
    """
    Main entry point for video composition
    
    Args:
        template_path (str): Path to template/mockup video
        product_path (str): Path to product video to insert
        output_dir (str): Directory to save output video
        detection_method (str): Method for screen detection ('contour', 'edge', 'color')
        max_frames (int): Maximum frames to process (None for all)
        enable_logging (bool): Enable detailed logging
    
    Returns:
        str: Path to the composed output video
    """
    
    # Use provided parameters or fall back to configured defaults
    template_path = template_path or TEMPLATE_VIDEO_PATH
    product_path = product_path or PRODUCT_VIDEO_PATH
    output_dir = output_dir or OUTPUT_DIRECTORY
    detection_method = detection_method or DETECTION_METHOD
    max_frames = max_frames or MAX_TRACKING_FRAMES
    
    print(f"\n🚀 Starting video composition process...")
    print(f"Timestamp: {time.strftime('%Y-%m-%d %H:%M:%S')}")
    
    try:
        # Create output directory if it doesn't exist
        print(f"\n📁 Ensuring output directory exists...")
        os.makedirs(output_dir, exist_ok=True)
        print(f"✅ Output directory ready: {output_dir}")
        
        # Initialize video composer
        print(f"\n🎬 Initializing video composer...")
        composer = VideoComposer()
        
        # Load videos
        print(f"\n📽️ Loading videos...")
        template_info, product_info = composer.load_videos(template_path, product_path)
        
        # Track screen across frames
        print(f"\n🎯 Tracking screen movement...")
        screen_positions = composer.track_screen_across_frames(
            max_frames=max_frames, 
            detection_method=detection_method
        )
        
        if not screen_positions or all(pos is None for pos in screen_positions):
            print("\n❌ ERROR: No screen positions detected in any frame!")
            print("💡 Suggestions:")
            print("   - Try a different detection method ('contour', 'edge', 'color')")
            print("   - Check if the template video contains a clear device screen")
            print("   - Verify the video file is not corrupted")
            return None
        
        # Compose the final video
        print(f"\n🎨 Composing final video...")
        output_path = os.path.join(output_dir, OUTPUT_FILENAME)
        
        def progress_callback(current, total):
            if enable_logging and current % 60 == 0:  # Log every 60 frames
                percent = (current / total) * 100
                print(f"   Composition progress: {percent:.1f}% ({current}/{total} frames)")
        
        result_path = composer.compose_videos(
            output_path, 
            progress_callback=progress_callback if enable_logging else None
        )
        
        # Clean up resources
        composer.cleanup()
        
        # Final success message
        print(f"\n🎉 SUCCESS! Video composition completed!")
        print(f"📁 Output file: {result_path}")
        if os.path.exists(result_path):
            file_size = os.path.getsize(result_path) / (1024 * 1024)  # MB
            print(f"📊 File size: {file_size:.2f} MB")
        
        return result_path
        
    except Exception as e:
        print(f"\n❌ ERROR during video composition: {str(e)}")
        print(f"Error type: {type(e).__name__}")
        
        # Try to clean up even if there's an error
        try:
            if 'composer' in locals():
                composer.cleanup()
        except:
            pass
        
        return None

