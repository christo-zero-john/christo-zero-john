class VideoComposer:
    def __init__(self):
        """Initialize the video composer with default settings"""
        print("🎬 Initializing VideoComposer...")
        self.template_video = None
        self.product_video = None
        self.screen_tracker = None
        print("✅ VideoComposer initialized")
    
    def load_videos(self, template_path, product_path):
        """Load template and product videos"""
        print(f"\n📁 Loading videos...")
        print(f"Template video: {template_path}")
        print(f"Product video: {product_path}")
        
        # Check if files exist
        if not os.path.exists(template_path):
            raise FileNotFoundError(f"Template video not found: {template_path}")
        if not os.path.exists(product_path):
            raise FileNotFoundError(f"Product video not found: {product_path}")
        
        # Load videos using OpenCV
        print("🎥 Loading template video...")
        self.template_video = cv2.VideoCapture(template_path)
        template_fps = self.template_video.get(cv2.CAP_PROP_FPS)
        template_frames = int(self.template_video.get(cv2.CAP_PROP_FRAME_COUNT))
        template_width = int(self.template_video.get(cv2.CAP_PROP_FRAME_WIDTH))
        template_height = int(self.template_video.get(cv2.CAP_PROP_FRAME_HEIGHT))
        
        print(f"📊 Template video info:")
        print(f"   - FPS: {template_fps}")
        print(f"   - Frames: {template_frames}")
        print(f"   - Resolution: {template_width}x{template_height}")
        print(f"   - Duration: {template_frames/template_fps:.2f} seconds")
        
        print("🎥 Loading product video...")
        self.product_video = cv2.VideoCapture(product_path)
        product_fps = self.product_video.get(cv2.CAP_PROP_FPS)
        product_frames = int(self.product_video.get(cv2.CAP_PROP_FRAME_COUNT))
        product_width = int(self.product_video.get(cv2.CAP_PROP_FRAME_WIDTH))
        product_height = int(self.product_video.get(cv2.CAP_PROP_FRAME_HEIGHT))
        
        print(f"📊 Product video info:")
        print(f"   - FPS: {product_fps}")
        print(f"   - Frames: {product_frames}")
        print(f"   - Resolution: {product_width}x{product_height}")
        print(f"   - Duration: {product_frames/product_fps:.2f} seconds")
        
        print("✅ Videos loaded successfully!")
        return (template_fps, template_frames, template_width, template_height), \
               (product_fps, product_frames, product_width, product_height)
    
    def detect_screen_area(self, frame, method='contour'):
        """Detect the device screen area in a frame using various methods"""
        print(f"🔍 Detecting screen area using {method} method...")
        
        if method == 'contour':
            return self._detect_screen_contour(frame)
        elif method == 'edge':
            return self._detect_screen_edges(frame)
        elif method == 'color':
            return self._detect_screen_color(frame)
        else:
            print(f"⚠️ Unknown method {method}, using contour method")
            return self._detect_screen_contour(frame)
    
    def _detect_screen_contour(self, frame):
        """Detect screen using contour detection (works well for rectangular screens)"""
        print("🔍 Using contour detection for screen area...")
        
        # Convert to grayscale
        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        print("   - Converted to grayscale")
        
        # Apply Gaussian blur to reduce noise
        blurred = cv2.GaussianBlur(gray, (5, 5), 0)
        print("   - Applied Gaussian blur")
        
        # Edge detection
        edges = cv2.Canny(blurred, 50, 150)
        print("   - Applied Canny edge detection")
        
        # Find contours
        contours, _ = cv2.findContours(edges, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        print(f"   - Found {len(contours)} contours")
        
        # Filter contours by area and aspect ratio
        screen_candidates = []
        min_area = frame.shape[0] * frame.shape[1] * 0.05  # At least 5% of frame
        max_area = frame.shape[0] * frame.shape[1] * 0.8   # At most 80% of frame
        
        for contour in contours:
            area = cv2.contourArea(contour)
            if min_area < area < max_area:
                # Approximate the contour to a polygon
                epsilon = 0.02 * cv2.arcLength(contour, True)
                approx = cv2.approxPolyDP(contour, epsilon, True)
                
                # Look for quadrilaterals (4 corners)
                if len(approx) >= 4:
                    screen_candidates.append((area, approx))
        
        print(f"   - Found {len(screen_candidates)} screen candidates")
        
        if screen_candidates:
            # Select the largest candidate
            screen_candidates.sort(key=lambda x: x[0], reverse=True)
            _, best_contour = screen_candidates[0]
            
            # Get the four corners
            corners = self._order_points(best_contour.reshape(-1, 2))
            print(f"   - Selected screen corners: {corners}")
            return corners
        
        print("   - No suitable screen area found")
        return None
    
    def _detect_screen_edges(self, frame):
        """Detect screen using edge-based method (good for high contrast screens)"""
        print("🔍 Using edge-based detection for screen area...")
        
        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        
        # Use adaptive threshold for better edge detection
        thresh = cv2.adaptiveThreshold(gray, 255, cv2.ADAPTIVE_THRESH_GAUSSIAN_C, 
                                      cv2.THRESH_BINARY, 11, 2)
        
        # Morphological operations to clean up
        kernel = np.ones((3, 3), np.uint8)
        cleaned = cv2.morphologyEx(thresh, cv2.MORPH_CLOSE, kernel)
        
        # Find contours
        contours, _ = cv2.findContours(cleaned, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        
        # Similar filtering as contour method
        return self._filter_and_select_screen(contours, frame)
    
    def _detect_screen_color(self, frame):
        """Detect screen using color-based method (good for screens with distinct colors)"""
        print("🔍 Using color-based detection for screen area...")
        
        # Convert to HSV for better color filtering
        hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
        
        # Define range for screen-like colors (adjust as needed)
        # This targets darker areas that might be screens
        lower_screen = np.array([0, 0, 0])
        upper_screen = np.array([180, 255, 100])
        
        mask = cv2.inRange(hsv, lower_screen, upper_screen)
        
        # Morphological operations
        kernel = np.ones((5, 5), np.uint8)
        mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel)
        mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel)
        
        # Find contours
        contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        
        return self._filter_and_select_screen(contours, frame)
    
    def _filter_and_select_screen(self, contours, frame):
        """Common method to filter and select the best screen candidate"""
        screen_candidates = []
        min_area = frame.shape[0] * frame.shape[1] * 0.02
        max_area = frame.shape[0] * frame.shape[1] * 0.7
        
        for contour in contours:
            area = cv2.contourArea(contour)
            if min_area < area < max_area:
                # Check if contour is roughly rectangular
                x, y, w, h = cv2.boundingRect(contour)
                aspect_ratio = w / h
                
                # Screen-like aspect ratios (0.5 to 2.0)
                if 0.5 <= aspect_ratio <= 2.0:
                    screen_candidates.append((area, contour))
        
        if screen_candidates:
            screen_candidates.sort(key=lambda x: x[0], reverse=True)
            _, best_contour = screen_candidates[0]
            
            # Get bounding rectangle and convert to corners
            x, y, w, h = cv2.boundingRect(best_contour)
            corners = np.array([
                [x, y],           # top-left
                [x + w, y],       # top-right
                [x + w, y + h],   # bottom-right
                [x, y + h]        # bottom-left
            ], dtype=np.float32)
            
            return corners
        
        return None
    
    def _order_points(self, pts):
        """Order points in clockwise order: top-left, top-right, bottom-right, bottom-left"""
        # Sort points by sum (top-left has smallest sum, bottom-right has largest)
        sum_pts = pts.sum(axis=1)
        diff_pts = np.diff(pts, axis=1)
        
        rect = np.zeros((4, 2), dtype=np.float32)
        rect[0] = pts[np.argmin(sum_pts)]      # top-left
        rect[2] = pts[np.argmax(sum_pts)]      # bottom-right
        rect[1] = pts[np.argmin(diff_pts)]     # top-right
        rect[3] = pts[np.argmax(diff_pts)]     # bottom-left
        
        return rect
    
    def track_screen_across_frames(self, max_frames=None, detection_method='contour'):
        """Track screen position across all frames of the template video"""
        print(f"\n🎯 Starting screen tracking across frames...")
        print(f"Detection method: {detection_method}")
        
        if self.template_video is None:
            raise ValueError("Template video not loaded. Call load_videos() first.")
        
        # Reset video to beginning
        self.template_video.set(cv2.CAP_PROP_POS_FRAMES, 0)
        
        total_frames = int(self.template_video.get(cv2.CAP_PROP_FRAME_COUNT))
        if max_frames:
            total_frames = min(total_frames, max_frames)
            print(f"Limiting analysis to {max_frames} frames")
        
        screen_positions = []
        frame_count = 0
        
        print(f"Processing {total_frames} frames...")
        progress_bar = tqdm(total=total_frames, desc="Tracking screen")
        
        while frame_count < total_frames:
            ret, frame = self.template_video.read()
            if not ret:
                print(f"\n⚠️ End of video reached at frame {frame_count}")
                break
            
            # Detect screen in current frame
            corners = self.detect_screen_area(frame, method=detection_method)
            
            if corners is not None:
                screen_positions.append(corners)
                if frame_count % 30 == 0:  # Log every 30 frames
                    print(f"\n   Frame {frame_count}: Screen detected at {corners[0]} to {corners[2]}")
            else:
                # If no screen detected, use interpolation or previous position
                if screen_positions:
                    screen_positions.append(screen_positions[-1])  # Use last known position
                    if frame_count % 30 == 0:
                        print(f"\n   Frame {frame_count}: No screen detected, using previous position")
                else:
                    screen_positions.append(None)
                    if frame_count % 30 == 0:
                        print(f"\n   Frame {frame_count}: No screen detected, no previous position")
            
            frame_count += 1
            progress_bar.update(1)
        
        progress_bar.close()
        
        # Statistics
        detected_frames = sum(1 for pos in screen_positions if pos is not None)
        detection_rate = (detected_frames / len(screen_positions)) * 100 if screen_positions else 0
        
        print(f"\n📊 Screen tracking completed:")
        print(f"   - Total frames processed: {len(screen_positions)}")
        print(f"   - Frames with screen detected: {detected_frames}")
        print(f"   - Detection rate: {detection_rate:.1f}%")
        
        self.screen_positions = screen_positions
        return screen_positions
    
    def create_warped_product_frame(self, product_frame, screen_corners):
        """Warp product frame to fit into the screen area"""
        if screen_corners is None:
            return None
        
        # Define destination points (product video corners)
        h, w = product_frame.shape[:2]
        product_corners = np.array([
            [0, 0],         # top-left
            [w, 0],         # top-right
            [w, h],         # bottom-right
            [0, h]          # bottom-left
        ], dtype=np.float32)
        
        # Calculate perspective transformation matrix
        matrix = cv2.getPerspectiveTransform(product_corners, screen_corners)
        
        # Apply perspective transformation
        template_height, template_width = 720, 1280  # Default, will be updated
        warped = cv2.warpPerspective(product_frame, matrix, (template_width, template_height))
        
        return warped
    
    def compose_videos(self, output_path, progress_callback=None):
        """Compose the final video by fitting product video into template screen"""
        print(f"\n🎬 Starting video composition...")
        print(f"Output path: {output_path}")
        
        if self.screen_positions is None:
            raise ValueError("Screen tracking not completed. Run track_screen_across_frames() first.")
        
        # Reset videos to beginning
        self.template_video.set(cv2.CAP_PROP_POS_FRAMES, 0)
        self.product_video.set(cv2.CAP_PROP_POS_FRAMES, 0)
        
        # Get video properties
        template_fps = self.template_video.get(cv2.CAP_PROP_FPS)
        template_width = int(self.template_video.get(cv2.CAP_PROP_FRAME_WIDTH))
        template_height = int(self.template_video.get(cv2.CAP_PROP_FRAME_HEIGHT))
        
        # Setup video writer
        fourcc = cv2.VideoWriter_fourcc(*'mp4v')
        out = cv2.VideoWriter(output_path, fourcc, template_fps, 
                             (template_width, template_height))
        
        print(f"📊 Output video settings:")
        print(f"   - Resolution: {template_width}x{template_height}")
        print(f"   - FPS: {template_fps}")
        print(f"   - Total frames to process: {len(self.screen_positions)}")
        
        # Progress tracking
        progress_bar = tqdm(total=len(self.screen_positions), desc="Compositing video")
        
        for frame_idx, screen_corners in enumerate(self.screen_positions):
            # Read template frame
            ret_template, template_frame = self.template_video.read()
            if not ret_template:
                print(f"\n⚠️ Template video ended at frame {frame_idx}")
                break
            
            # Read product frame (with looping)
            ret_product, product_frame = self.product_video.read()
            if not ret_product:
                # Loop product video
                print(f"\n🔄 Looping product video at frame {frame_idx}")
                self.product_video.set(cv2.CAP_PROP_POS_FRAMES, 0)
                ret_product, product_frame = self.product_video.read()
            
            if ret_product and screen_corners is not None:
                # Warp product frame to fit screen
                warped_product = self.create_warped_product_frame(product_frame, screen_corners)
                
                if warped_product is not None:
                    # Create mask for the warped region
                    mask = np.zeros((template_height, template_width), dtype=np.uint8)
                    cv2.fillPoly(mask, [screen_corners.astype(np.int32)], 255)
                    
                    # Blend the warped product into template
                    result_frame = template_frame.copy()
                    mask_3d = cv2.merge([mask, mask, mask]) / 255.0
                    
                    result_frame = (result_frame * (1 - mask_3d) + 
                                  warped_product * mask_3d).astype(np.uint8)
                else:
                    result_frame = template_frame
            else:
                # No product frame or screen detected, use template only
                result_frame = template_frame
            
            # Write frame to output
            out.write(result_frame)
            
            # Progress logging
            if frame_idx % 30 == 0:  # Log every 30 frames
                progress_percent = (frame_idx / len(self.screen_positions)) * 100
                print(f"\n   Frame {frame_idx}: {progress_percent:.1f}% complete")
            
            progress_bar.update(1)
            
            if progress_callback:
                progress_callback(frame_idx, len(self.screen_positions))
        
        progress_bar.close()
        
        # Clean up
        out.release()
        
        print(f"\n✅ Video composition completed!")
        print(f"Output saved to: {output_path}")
        print(f"Total frames processed: {len(self.screen_positions)}")
        
        return output_path
    
    def cleanup(self):
        """Clean up video captures"""
        print("🧹 Cleaning up resources...")
        if self.template_video:
            self.template_video.release()
        if self.product_video:
            self.product_video.release()
        print("✅ Cleanup completed")

